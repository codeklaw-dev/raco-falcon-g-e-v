# syntax=docker/dockerfile:1
#
# Production image for Fly.io. Unlike ./Dockerfile (which runs the Vite *dev*
# server for local use), this builds the client once and serves it with
# `vite preview`, which mounts the same API proxy middleware.
FROM node:24.22.2-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c

ENV PUPPETEER_SKIP_DOWNLOAD=1
WORKDIR /app
RUN chown node:node /app
USER node

COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY --chown=node:node . .

# These two are *browser* keys: Vite inlines them into the public JS bundle,
# so they must be present at build time. Restrict them by HTTP referrer in
# the Google Cloud / Cesium ion consoles. Server-side keys (OpenAI, Gemini,
# OpenSky, ...) are NOT build args; set them with `fly secrets set`.
ARG GOOGLE_MAPS_API_KEY=""
ARG CESIUM_ION_TOKEN=""
RUN GOOGLE_MAPS_API_KEY="$GOOGLE_MAPS_API_KEY" CESIUM_ION_TOKEN="$CESIUM_ION_TOKEN" npm run build

ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080
EXPOSE 8080
CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "8080", "--strictPort"]
